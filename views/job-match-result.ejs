<style>.ai-shell{max-width:1000px;margin:3rem auto;padding:0 1rem}.ai-card{border:0;border-radius:18px;box-shadow:0 8px 30px rgba(15,23,42,.08)}.skill{display:inline-block;border-radius:999px;padding:.4rem .75rem;margin:.2rem;background:#dcfce7;color:#166534}.missing{background:#fee2e2;color:#991b1b}.score{font-size:4rem;font-weight:800;color:#0f766e}</style>
<section class="ai-shell"><a href="/ai/job-match" class="text-decoration-none">← New match</a><div class="card ai-card mt-3"><div class="card-body p-4 p-md-5"><div class="row align-items-center"><div class="col-md-5 text-center border-end"><div class="score"><%= match.matchPercentage %>%</div><h3>Role match</h3><span class="badge text-bg-<%= match.hiringProbability === 'High' ? 'success' : match.hiringProbability === 'Medium' ? 'warning' : 'danger' %>"><%= match.hiringProbability %> hiring probability</span></div><div class="col-md-7 ps-md-5 mt-4 mt-md-0"><h1><%= match.student.name %></h1><p class="lead mb-1"><%= match.company.name %><%= match.company.jobRole ? ' · ' + match.company.jobRole : '' %></p><p class="text-muted">Calculated from the latest saved resume analysis and configured company requirements.</p><h5>Matched skills</h5><% (match.matchedSkills || []).forEach(function(skill){ %><span class="skill"><%= skill %></span><% }) %><h5 class="mt-4">Missing skills</h5><% (match.missingSkills || []).forEach(function(skill){ %><span class="skill missing"><%= skill %></span><% }) %></div></div><hr class="my-4"><h4>Recommended learning path</h4><ol><% (match.recommendedLearningPath || []).forEach(function(item){ %><li class="mb-2"><%= item %></li><% }) %></ol></div></div></section>
