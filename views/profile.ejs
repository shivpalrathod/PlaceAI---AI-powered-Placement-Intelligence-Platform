<link rel="stylesheet" href="<%= assetPath('css/profile.css') %>" />
<script defer src="<%= assetPath('js/update-profile.js') %>"></script>

<% if (locals.user) { %>

    <input type="hidden" id="employeeProfile" value="<%= locals.profile_user.id %>" />

    <div class="profilePage">
        <div id="updateProfile" class="ai-card" style="width: 90%; max-width: 1200px; padding: 2.5rem; background: #1e293b; border-color: rgba(139, 92, 246, 0.2);">
            
            <% if(locals.user.id==profile_user.id){ %>

                <form action="/update/<%= profile_user.id %>" method="post" enctype="multipart/form-data">
                    <h2 style="font-size: 2rem; font-weight: 800; text-align: center; margin-bottom: 2rem; background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">AI Placement Profile</h2>

                    <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;">
                        
                        <!-- Top Row: Photo and Score Widgets -->
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; align-items: center; justify-items: center; background: rgba(15, 23, 42, 0.4); padding: 2rem; border-radius: 14px; border: 1px solid rgba(139, 92, 246, 0.1);">
                            
                            <!-- Avatar Upload Section -->
                            <div style="text-align: center;">
                                <div class="upload-wrapper" style="width: 180px; height: 180px; margin: 0 auto 1rem; border-radius: 50%; border: 3px solid #8b5cf6; overflow: hidden; position: relative;">
                                    <img src="<%= profile_user.avatarPath || '/images/empty-avatar.png' %>" alt="Profile Image" style="width:100%; height:100%; object-fit:cover;" />
                                    <input type="file" name="avatar" class="image" accept="image/*" style="position: absolute; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer;" />
                                    <div style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15, 23, 42, 0.7); font-size: 0.75rem; color: #f8fafc; padding: 4px 0;">Change Photo</div>
                                </div>
                                <span style="font-size: 0.8rem; color: #94a3b8;"><i class="fa-solid fa-camera"></i> Click circle to upload new photo</span>
                            </div>

                            <!-- ATS Score Circle -->
                            <div style="text-align: center;">
                                <h4 style="font-size: 1rem; color: #94a3b8; font-weight: 700; margin-bottom: 0.75rem; text-transform: uppercase;">ATS Score</h4>
                                <div style="position: relative; width: 140px; height: 140px; margin: 0 auto; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle, #1e293b 70%, transparent 71%); border-radius: 50%;">
                                    <!-- Circular progress indicator using conic gradient -->
                                    <% const scoreVal = profile_user.atsScore || 0; %>
                                    <div style="position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(#8b5cf6 <%= scoreVal * 3.6 %>deg, rgba(255,255,255,0.05) 0deg); z-index: 1;"></div>
                                    <div style="position: absolute; inset: 12px; border-radius: 50%; background: #1e293b; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                        <span style="font-size: 2.25rem; font-weight: 900; color: #f8fafc; line-height: 1;"><%= scoreVal %></span>
                                        <span style="font-size: 0.65rem; color: #94a3b8; text-transform: uppercase; font-weight: 700;">Strength: <%= scoreVal >= 80 ? 'Strong' : scoreVal >= 60 ? 'Medium' : 'Weak' %></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Placement Readiness Widget -->
                            <div style="text-align: center; width: 100%;">
                                <h4 style="font-size: 1rem; color: #94a3b8; font-weight: 700; margin-bottom: 1rem; text-transform: uppercase;">Placement Readiness</h4>
                                <% const readVal = profile_user.placementReadinessScore || 0; %>
                                <div style="font-size: 2.5rem; font-weight: 900; color: <%= readVal >= 70 ? '#10b981' : readVal >= 40 ? '#f59e0b' : '#ef4444' %>; line-height:1; margin-bottom:0.5rem;"><%= readVal %>%</div>
                                <div class="skill-progress-bar" style="max-width: 200px; margin: 0 auto 0.5rem; background: rgba(255,255,255,0.05); height: 8px; border-radius: 4px; overflow:hidden;">
                                    <div style="background: <%= readVal >= 70 ? '#10b981' : readVal >= 40 ? '#f59e0b' : '#ef4444' %>; height:100%; width: <%= readVal %>%;"></div>
                                </div>
                                <span style="font-size: 0.8rem; color: #94a3b8;">Status: <%= readVal >= 70 ? 'Industry Ready' : readVal >= 40 ? 'Developing' : 'Needs Work' %></span>
                            </div>

                        </div>

                        <!-- Info Inputs & Resume Upload -->
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                            
                            <div class="info">
                                <div class="form-group" style="margin-bottom: 1.25rem;">
                                    <label style="font-weight: 600; color: #f8fafc; margin-bottom: 0.5rem; display: block;">Full Name</label>
                                    <input type="text" id="name" class="form-control" name="name" value="<%= profile_user.name %>" required style="background:#0f172a; border-color: rgba(139,92,246,0.2); color:#f8fafc;" />
                                </div>

                                <div class="form-group" style="margin-bottom: 1.25rem;">
                                    <label style="font-weight: 600; color: #f8fafc; margin-bottom: 0.5rem; display: block;">Email Address</label>
                                    <input type="email" id="email" class="form-control" name="email" value="<%= profile_user.email %>" required style="background:#0f172a; border-color: rgba(139,92,246,0.2); color:#f8fafc;" />
                                </div>

                                <div class="form-group" style="margin-bottom: 1.25rem;">
                                    <label style="font-weight: 600; color: #f8fafc; margin-bottom: 0.5rem; display: block;">Update Password</label>
                                    <input type="password" id="password" class="form-control" name="password" value="<%= profile_user.password %>" required style="background:#0f172a; border-color: rgba(139,92,246,0.2); color:#f8fafc;" />
                                </div>
                            </div>

                            <div class="info" style="display: flex; flex-direction: column; justify-content: space-between;">
                                <div class="form-group" style="margin-bottom: 1.25rem;">
                                    <label style="font-weight: 600; color: #f8fafc; margin-bottom: 0.5rem; display: block;">📄 Upload Resume (PDF)</label>
                                    <input type="file" class="form-control" name="resume" accept=".pdf" style="background:#0f172a; border-color: rgba(139,92,246,0.2); color:#f8fafc;" />
                                    <small style="color:#94a3b8; display:block; margin-top:0.4rem;">
                                        <% if (profile_user.resumePath) { %>
                                            <span style="color:#6ee7b7;"><i class="fa-solid fa-circle-check"></i> Current Resume: </span>
                                            <a href="<%= profile_user.resumePath %>" target="_blank" style="color:#a78bfa; text-decoration: underline;"><%= profile_user.resumePath.split('/').pop() %></a>
                                        <% } else { %>
                                            No resume uploaded. Upload PDF to generate AI insights.
                                        <% } %>
                                    </small>
                                </div>

                                <button type="submit" class="apply-btn" style="width: 100%; padding: 0.8rem; font-weight: 700; border-radius: 8px; font-size: 1rem; border: none; background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%);">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> Save Profile & Analyze Resume
                                </button>
                            </div>

                        </div>

                        <hr style="border-color: rgba(255,255,255,0.1); margin: 1rem 0;">

                        <!-- Dynamic Resume Content Blocks -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; @media screen and (max-width: 768px) { grid-template-columns: 1fr; }">
                            
                            <!-- Skills Tags -->
                            <div>
                                <h3 style="font-size: 1.25rem; font-weight: 700; color: #a78bfa; margin-bottom: 1rem;"><i class="fa-solid fa-code"></i> Extracted Skills</h3>
                                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                    <% if (profile_user.skills && profile_user.skills.length > 0) { %>
                                        <% profile_user.skills.forEach(function(skill) { %>
                                            <span class="skill-tag skill-tag-primary" style="background: rgba(139, 92, 246, 0.15); color: #c4b5fd; border: 1px solid rgba(139, 92, 246, 0.3);"><%= skill %></span>
                                        <% }); %>
                                    <% } else { %>
                                        <p style="color:#94a3b8; font-size: 0.9rem; font-style: italic;">Skills will be automatically extracted once you upload a resume.</p>
                                    <% } %>
                                </div>
                            </div>

                            <!-- AI Suggestions / Career Insights -->
                            <div>
                                <h3 style="font-size: 1.25rem; font-weight: 700; color: #a78bfa; margin-bottom: 1rem;"><i class="fa-solid fa-robot"></i> AI Suggestions</h3>
                                <div style="background: rgba(139, 92, 246, 0.05); padding: 1.25rem; border-radius: 12px; border-left: 4px solid #8b5cf6;">
                                    <% if (locals.analysis && locals.analysis.improvements) { %>
                                        <strong style="color: #f8fafc; display: block; font-size: 0.9rem; margin-bottom: 0.4rem;">Summary recommendation:</strong>
                                        <p style="color: #94a3b8; font-size: 0.875rem; line-height: 1.5; margin-bottom: 0.75rem;"><%= locals.analysis.improvements.betterSummary %></p>
                                        
                                        <% if (locals.analysis.improvementSuggestions && locals.analysis.improvementSuggestions.length > 0) { %>
                                            <strong style="color: #f8fafc; display: block; font-size: 0.9rem; margin-bottom: 0.4rem;">Action items:</strong>
                                            <ul style="color: #94a3b8; font-size: 0.85rem; padding-left: 1.25rem; margin-bottom: 0;">
                                                <% locals.analysis.improvementSuggestions.slice(0, 3).forEach(function(sug) { %>
                                                    <li style="margin-bottom:0.25rem;"><%= sug %></li>
                                                <% }); %>
                                            </ul>
                                        <% } %>
                                    <% } else { %>
                                        <p style="color:#94a3b8; font-size: 0.9rem; font-style: italic; margin-bottom: 0;">Upload your resume to get automated AI feedback and suggestions.</p>
                                    <% } %>
                                </div>
                            </div>

                        </div>

                        <!-- Projects, Certifications, Education Details -->
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1rem;">
                            
                            <!-- Projects -->
                            <div style="background: rgba(15, 23, 42, 0.3); padding: 1.5rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                <h4 style="font-size: 1.1rem; font-weight: 700; color: #c084fc; margin-bottom: 0.75rem;"><i class="fa-solid fa-diagram-project"></i> Key Projects</h4>
                                <ul style="padding-left:1.25rem; color:#94a3b8; font-size:0.9rem; margin-bottom:0;">
                                    <% if (profile_user.projects && profile_user.projects.length > 0) { %>
                                        <% profile_user.projects.forEach(function(proj) { %>
                                            <li style="margin-bottom:0.4rem; color: #f8fafc;"><%= proj %></li>
                                        <% }); %>
                                    <% } else { %>
                                        <li style="font-style:italic;">No projects extracted yet.</li>
                                    <% } %>
                                </ul>
                            </div>

                            <!-- Certifications -->
                            <div style="background: rgba(15, 23, 42, 0.3); padding: 1.5rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                <h4 style="font-size: 1.1rem; font-weight: 700; color: #c084fc; margin-bottom: 0.75rem;"><i class="fa-solid fa-certificate"></i> Certifications</h4>
                                <ul style="padding-left:1.25rem; color:#94a3b8; font-size:0.9rem; margin-bottom:0;">
                                    <% if (profile_user.certifications && profile_user.certifications.length > 0) { %>
                                        <% profile_user.certifications.forEach(function(cert) { %>
                                            <li style="margin-bottom:0.4rem; color: #f8fafc;"><%= cert %></li>
                                        <% }); %>
                                    <% } else { %>
                                        <li style="font-style:italic;">No certifications extracted yet.</li>
                                    <% } %>
                                </ul>
                            </div>

                            <!-- Education -->
                            <div style="background: rgba(15, 23, 42, 0.3); padding: 1.5rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                <h4 style="font-size: 1.1rem; font-weight: 700; color: #c084fc; margin-bottom: 0.75rem;"><i class="fa-solid fa-graduation-cap"></i> Education</h4>
                                <ul style="padding-left:1.25rem; color:#94a3b8; font-size:0.9rem; margin-bottom:0;">
                                    <% if (profile_user.education && profile_user.education.length > 0) { %>
                                        <% profile_user.education.forEach(function(edu) { %>
                                            <li style="margin-bottom:0.4rem; color: #f8fafc;"><%= edu %></li>
                                        <% }); %>
                                    <% } else { %>
                                        <li style="font-style:italic;">No education details extracted yet.</li>
                                    <% } %>
                                </ul>
                            </div>

                        </div>

                        <!-- Recommendations Grid -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.5rem;">
                            
                            <!-- Recommended Jobs -->
                            <div>
                                <h3 style="font-size: 1.25rem; font-weight: 700; color: #8b5cf6; margin-bottom: 1rem;"><i class="fa-solid fa-briefcase"></i> Recommended Jobs</h3>
                                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                    <% if (locals.recommendedJobs && recommendedJobs.length > 0) { %>
                                        <% recommendedJobs.forEach(function(job) { %>
                                            <div style="background: rgba(15, 23, 42, 0.4); padding: 1rem; border-radius: 10px; border: 1px solid rgba(139, 92, 246, 0.15); display: flex; justify-content: space-between; align-items: center;">
                                                <div>
                                                    <div style="font-weight: 700; color: #f8fafc; font-size: 0.95rem;"><%= job.title %></div>
                                                    <div style="color: #94a3b8; font-size: 0.85rem;"><%= job.company %> • <%= job.location %></div>
                                                </div>
                                                <div style="text-align: right;">
                                                    <span class="match-badge high" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;"><%= job.matchPercent %>% match</span>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <p style="color:#94a3b8; font-size:0.9rem; font-style:italic;">Upload resume to unlock job matches.</p>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Recommended Internships -->
                            <div>
                                <h3 style="font-size: 1.25rem; font-weight: 700; color: #8b5cf6; margin-bottom: 1rem;"><i class="fa-solid fa-graduation-cap"></i> Recommended Internships</h3>
                                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                    <% if (locals.recommendedInternships && recommendedInternships.length > 0) { %>
                                        <% recommendedInternships.forEach(function(intern) { %>
                                            <div style="background: rgba(15, 23, 42, 0.4); padding: 1rem; border-radius: 10px; border: 1px solid rgba(139, 92, 246, 0.15); display: flex; justify-content: space-between; align-items: center;">
                                                <div>
                                                    <div style="font-weight: 700; color: #f8fafc; font-size: 0.95rem;"><%= intern.title %></div>
                                                    <div style="color: #94a3b8; font-size: 0.85rem;"><%= intern.company %> • <%= intern.stipend %> • <%= intern.duration %></div>
                                                </div>
                                                <div style="text-align: right;">
                                                    <span class="match-badge high" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;"><%= intern.matchPercent %>% match</span>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <p style="color:#94a3b8; font-size:0.9rem; font-style:italic;">Upload resume to unlock internship matches.</p>
                                    <% } %>
                                </div>
                            </div>

                        </div>

                    </div>
                </form>

            <% } %>

        </div>
    </div>

<% } %>