<style>
 .ai-shell{max-width:1150px;margin:3rem auto;padding:0 1rem}.score-ring{width:150px;height:150px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#2563eb calc(var(--score)*1%),#e2e8f0 0)}.score-ring>div{width:120px;height:120px;background:#fff;border-radius:50%;display:grid;place-items:center}.ai-card{border:0;border-radius:18px;box-shadow:0 8px 30px rgba(15,23,42,.08);height:100%}.skill{display:inline-block;background:#dbeafe;color:#1e3a8a;border-radius:999px;padding:.35rem .7rem;margin:.2rem;font-size:.9rem}.risk{background:#fee2e2;color:#991b1b}.ok{background:#dcfce7;color:#166534}.ai-list li{margin-bottom:.65rem}
</style>
<section class="ai-shell"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><a href="/ai/resume" class="text-decoration-none">← New analysis</a><h1 class="mt-2 mb-1"><%= analysis.student.name %>'s resume review</h1><p class="text-muted mb-0">Generated <%= analysis.createdAt.toLocaleDateString() %> · <%= analysis.analysisSource === 'gemini' ? 'Gemini-enhanced' : 'Local structured analysis' %></p></div><a class="btn btn-outline-primary" href="<%= analysis.resumePath %>" target="_blank">View PDF</a></div><div class="row g-4 mb-4"><div class="col-md-4"><div class="card ai-card"><div class="card-body text-center p-4"><div class="score-ring mx-auto" style="--score:<%= analysis.atsScore %>"><div><strong class="fs-2"><%= analysis.atsScore %></strong><small>ATS / 100</small></div></div><p class="mt-3 mb-0 fw-semibold">Applicant tracking compatibility</p></div></div></div><div class="col-md-4"><div class="card ai-card"><div class="card-body p-4"><h5>Placement readiness</h5><div class="progress mt-3" style="height:18px"><div class="progress-bar" style="width:<%= analysis.placementReadinessScore %>%"><%= analysis.placementReadinessScore %>%</div></div><p class="small text-muted mt-3 mb-0">A combined signal from skills, resume structure, and evidence of practical work.</p></div></div></div><div class="col-md-4"><div class="card ai-card"><div class="card-body p-4"><h5>Next move</h5><p class="mb-0"><%= (analysis.improvementSuggestions || [])[0] || 'Keep tailoring your resume to the target role.' %></p></div></div></div></div><div class="row g-4"><div class="col-lg-6"><div class="card ai-card"><div class="card-body p-4"><h4>Skills found</h4><h6 class="mt-3">Technical</h6><% (analysis.technicalSkills || []).forEach(function(skill){ %><span class="skill"><%= skill %></span><% }) %><h6 class="mt-3">Soft skills</h6><% (analysis.softSkills || []).forEach(function(skill){ %><span class="skill ok"><%= skill %></span><% }) %></div></div></div><div class="col-lg-6"><div class="card ai-card"><div class="card-body p-4"><h4>Skills to strengthen</h4><% (analysis.missingSkills || []).forEach(function(skill){ %><span class="skill risk"><%= skill %></span><% }) %><h6 class="mt-4">Recommendations</h6><ul class="ai-list ps-3"><% (analysis.improvementSuggestions || []).forEach(function(item){ %><li><%= item %></li><% }) %></ul></div></div></div><div class="col-lg-6"><div class="card ai-card"><div class="card-body p-4"><h4>What works</h4><ul class="ai-list ps-3"><% (analysis.strengths || []).forEach(function(item){ %><li><%= item %></li><% }) %></ul><h4 class="mt-4">What to fix</h4><ul class="ai-list ps-3"><% (analysis.weaknesses || []).forEach(function(item){ %><li><%= item %></li><% }) %></ul></div></div></div><div class="col-lg-6"><div class="card ai-card"><div class="card-body p-4"><h4>Improvement assistant</h4><p><strong>Better summary:</strong> <%= analysis.improvements.betterSummary %></p><h6>Missing sections</h6><ul class="ps-3"><% (analysis.improvements.missingSections || []).forEach(function(item){ %><li><%= item %></li><% }) %></ul><h6>Project & grammar coaching</h6><ul class="ps-3"><% (analysis.improvements.projectSuggestions || []).concat(analysis.improvements.grammarSuggestions || []).forEach(function(item){ %><li><%= item %></li><% }) %></ul></div></div></div></div></section>
