<style>
  .ai-shell{max-width:1050px;margin:3rem auto;padding:0 1rem}.ai-hero{background:linear-gradient(135deg,#172554,#2563eb);color:#fff;border-radius:20px;padding:2.5rem}.ai-card{border:0;border-radius:18px;box-shadow:0 12px 35px rgba(15,23,42,.1)}.ai-chip{background:#e0e7ff;color:#3730a3;border-radius:999px;padding:.35rem .75rem;font-weight:600;font-size:.85rem}.upload-zone{border:2px dashed #93c5fd;border-radius:14px;padding:2rem;background:#f8fbff}
</style>
<section class="ai-shell"><div class="ai-hero mb-4"><span class="ai-chip bg-white text-primary">AI placement suite</span><h1 class="mt-3">Resume Analyzer</h1><p class="mb-0">Upload a text-based PDF to generate an ATS review, readiness score, skill inventory, and practical improvement plan.</p></div><div class="card ai-card"><div class="card-body p-4 p-md-5"><form action="/ai/resume/analyze" method="post" enctype="multipart/form-data"><div class="row g-4"><div class="col-md-6"><label class="form-label fw-semibold">Student</label><select class="form-select" name="studentId" required><option value="">Choose a student</option><% students.forEach(function(student) { %><option value="<%= student._id %>"><%= student.name %> · <%= student.college %></option><% }) %></select></div><div class="col-md-6"><label class="form-label fw-semibold">Resume PDF</label><div class="upload-zone"><input class="form-control" type="file" name="resume" accept="application/pdf" required><small class="text-muted d-block mt-2">PDF only, up to 5 MB. Scanned-image PDFs may not contain readable text.</small></div></div></div><button class="btn btn-primary btn-lg mt-4" type="submit"><i class="fa-solid fa-wand-magic-sparkles me-2"></i>Analyze resume</button></form></div></div></section>
