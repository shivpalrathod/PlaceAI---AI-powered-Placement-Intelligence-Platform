<style>.ai-shell{max-width:1100px;margin:3rem auto;padding:0 1rem}.ai-card{border:0;border-radius:18px;box-shadow:0 8px 30px rgba(15,23,42,.08);height:100%}.question{border-left:4px solid #8b5cf6;padding:.75rem 1rem;background:#faf5ff;border-radius:0 10px 10px 0;margin-bottom:.75rem}</style>
<section class="ai-shell"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4"><div><a href="/ai/interview" class="text-decoration-none">← New question set</a><h1 class="mt-2"><%= questions.jobRole %> preparation</h1><p class="text-muted mb-0"><%= questions.experienceLevel %> · <%= questions.companyType %> · <%= questions.analysisSource === 'gemini' ? 'Gemini-enhanced' : 'Structured preparation set' %></p></div></div><div class="row g-4"><% const groups = [{name:'Technical questions',items:questions.technicalQuestions},{name:'HR questions',items:questions.hrQuestions},{name:'Scenario-based questions',items:questions.scenarioQuestions},{name:'Coding questions',items:questions.codingQuestions}]; groups.forEach(function(group){ %><div class="col-md-6"><div class="card ai-card"><div class="card-body p-4"><h4><%= group.name %></h4><% (group.items || []).forEach(function(item){ %><div class="question"><span class="badge text-bg-<%= item.difficulty === 'Hard' ? 'danger' : item.difficulty === 'Medium' ? 'warning' : 'success' %> mb-2"><%= item.difficulty %></span><div><%= item.question %></div></div><% }) %></div></div></div><% }) %></div></section>
