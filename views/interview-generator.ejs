<style>.ai-shell{max-width:900px;margin:3rem auto;padding:0 1rem}.ai-card{border:0;border-radius:18px;box-shadow:0 12px 35px rgba(15,23,42,.1)}.ai-hero{background:linear-gradient(135deg,#7e22ce,#c026d3);color:#fff;border-radius:20px;padding:2.2rem}</style>
<section class="ai-shell"><div class="ai-hero mb-4"><h1>Interview Question Generator</h1><p class="mb-0">Generate role-specific technical, HR, scenario, and coding preparation questions with mixed difficulty.</p></div><div class="card ai-card"><div class="card-body p-4 p-md-5"><form method="post" action="/ai/interview/generate"><div class="row g-4"><div class="col-md-4"><label class="form-label fw-semibold">Job role</label><input class="form-control" name="jobRole" placeholder="e.g. Backend Developer" required></div><div class="col-md-4"><label class="form-label fw-semibold">Experience level</label><select class="form-select" name="experienceLevel" required><option value="Fresher">Fresher</option><option value="Junior">Junior</option><option value="Mid-level">Mid-level</option></select></div><div class="col-md-4"><label class="form-label fw-semibold">Company type</label><input class="form-control" name="companyType" placeholder="e.g. Product startup" required></div></div><button class="btn btn-primary btn-lg mt-4"><i class="fa-solid fa-sparkles me-2"></i>Generate questions</button></form></div></div></section>
