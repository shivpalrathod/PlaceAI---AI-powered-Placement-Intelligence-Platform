<style>.ai-shell{max-width:1050px;margin:3rem auto;padding:0 1rem}.ai-card{border:0;border-radius:18px;box-shadow:0 12px 35px rgba(15,23,42,.1)}.ai-hero{background:linear-gradient(135deg,#b45309,#f59e0b);color:#fff;border-radius:20px;padding:2.2rem}</style>
<section class="ai-shell"><div class="ai-hero mb-4"><h1>Placement Eligibility Checker</h1><p class="mb-0">Check CGPA, backlogs, and resume skills against a company's placement criteria. Values entered here are saved to the selected student and company.</p></div><div class="card ai-card"><div class="card-body p-4"><form action="/ai/eligibility/check" method="post"><div class="row g-3"><div class="col-md-6"><label class="form-label fw-semibold">Student</label><select class="form-select" name="studentId" required><option value="">Choose a student</option><% students.forEach(function(student){ %><option value="<%= student._id %>"><%= student.name %> <%= student.cgpa !== undefined ? '· CGPA ' + student.cgpa : '' %></option><% }) %></select></div><div class="col-md-6"><label class="form-label fw-semibold">Company</label><select class="form-select" name="companyId" required><option value="">Choose a company</option><% companies.forEach(function(company){ %><option value="<%= company._id %>"><%= company.name %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">Student CGPA</label><input class="form-control" type="number" min="0" max="10" step="0.01" name="studentCgpa" placeholder="e.g. 7.5"></div><div class="col-md-3"><label class="form-label">Student backlogs</label><input class="form-control" type="number" min="0" name="studentBacklogs" placeholder="e.g. 0"></div><div class="col-md-3"><label class="form-label">Minimum CGPA</label><input class="form-control" type="number" min="0" max="10" step="0.01" name="minimumCgpa" placeholder="e.g. 7.0"></div><div class="col-md-3"><label class="form-label">Allowed backlogs</label><input class="form-control" type="number" min="0" name="allowedBacklogs" placeholder="e.g. 0"></div><div class="col-12"><label class="form-label">Required skills</label><input class="form-control" name="requiredSkills" placeholder="React, Node.js, MongoDB"></div></div><button class="btn btn-warning mt-4">Check eligibility</button></form></div></div><% if (result) { %><div class="card ai-card mt-4 border-<%= result.eligible ? 'success' : 'danger' %>"><div class="card-body p-4"><div class="d-flex justify-content-between flex-wrap gap-2"><div><h2 class="text-<%= result.eligible ? 'success' : 'danger' %>"><%= result.eligible ? 'Eligible' : 'Not eligible' %></h2><p class="mb-0"><%= result.student.name %> · <%= result.company.name %></p></div><span class="badge text-bg-<%= result.selectionProbability === 'High' ? 'success' : result.selectionProbability === 'Medium' ? 'warning' : 'danger' %> align-self-start"><%= result.selectionProbability %> selection probability</span></div><hr><ul class="mb-0"><% result.reasons.forEach(function(reason){ %><li class="mb-2"><%= reason %></li><% }) %></ul></div></div><% } %></section>
